# Copiar a .env.local y rellenar. .env.local está en .gitignore.
#
# Dashboard de Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio: ignora RLS. Sólo se usa en tareas que no actúan en nombre
# de un usuario (cron de apertura/cierre de sorteos, refresco de agregados).
# Nunca debe llegar al navegador — por eso NO lleva el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Digitalización asistida por IA (Fase 3). Google AI Studio → API keys.
# El modelo se fija en lib/ia/gemini.ts.
GOOGLE_API_KEY=

# Firma de las cookies de sesión. Los usuarios ya no viven en Supabase Auth sino
# en la tabla allan.usuario, así que la sesión la firma este servidor con HMAC.
# 32 caracteres o más. Generar con:
#     node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
# Cambiarlo cierra la sesión de todo el mundo, que es justo lo que se quiere si
# se sospecha que se filtró.
SESION_SECRETO=
