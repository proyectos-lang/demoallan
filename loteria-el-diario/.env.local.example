# Copiar a .env.local y rellenar. .env.local está en .gitignore.
#
# Dashboard de Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio: ignora RLS. Sólo se usa en tareas que no actúan en nombre
# de un usuario (cron de apertura/cierre de sorteos, refresco de agregados).
# Nunca debe llegar al navegador — por eso NO lleva el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Digitalización asistida por IA (Fase 3). Google AI Studio → API keys.
# El modelo se fija en lib/ia/gemini.ts.
GOOGLE_API_KEY=
