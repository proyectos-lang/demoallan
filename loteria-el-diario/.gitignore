# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Credenciales. `.env.local` lleva la llave de servicio de Supabase (ignora RLS)
# y la de Google. La plantilla sí se versiona: el README manda copiarla.
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hojas manuscritas de prueba: llevan apuestas reales
/muestras/*
!/muestras/LEEME.md
